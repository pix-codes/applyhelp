# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apply_help

# Encryption key for sensitive tokens at rest (Fernet key)
# Generated using: cryptography.fernet.Fernet.generate_key().decode()
APP_SECRET_KEY=kK_9j73hQyLqfU-7s0K1V2w3X4y5Z6a7b8c9d0e1f2g=

# LLM Configurations
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Cloudflare AI Gateway (Optional)
# Format: https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}
CLOUDFLARE_GATEWAY_URL=

# Default LLM settings
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=45

# Crawling and Scraping Settings
CRAWL_USER_AGENT=ApplyHelpBot/1.0 (+https://github.com/parakram/apply-help; personal-job-discovery)
CRAWL_DEFAULT_DELAY=3.0
CRAWL_MAX_CONCURRENT_GLOBAL=2
CRAWL_MAX_CONCURRENT_PER_DOMAIN=1

# Gmail OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501
